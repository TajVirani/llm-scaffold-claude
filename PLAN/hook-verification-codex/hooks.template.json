{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOOKTEST_DIR__/hooks/log.sh SessionStart"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "__HOOKTEST_DIR__/hooks/log.sh PreToolUse"
          }
        ]
      },
      {
        "matcher": ".*spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "__HOOKTEST_DIR__/hooks/pre_spawn_rewrite.sh"
          }
        ]
      },
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "__HOOKTEST_DIR__/hooks/pre_edit_allow.sh"
          },
          {
            "type": "command",
            "command": "__HOOKTEST_DIR__/hooks/pre_edit_deny.sh"
          }
        ]
      },
      {
        "matcher": "^(Bash|shell|exec_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "__HOOKTEST_DIR__/hooks/log.sh PreToolUse-ShellMatcher"
          }
        ]
      },
      {
        "matcher": "^Agent$",
        "hooks": [
          {
            "type": "command",
            "command": "__HOOKTEST_DIR__/hooks/log.sh M-Agent"
          }
        ]
      },
      {
        "matcher": "^spawn_agent$",
        "hooks": [
          {
            "type": "command",
            "command": "__HOOKTEST_DIR__/hooks/log.sh M-spawn_agent-anchored"
          }
        ]
      },
      {
        "matcher": "spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "__HOOKTEST_DIR__/hooks/log.sh M-spawn_agent-unanchored"
          }
        ]
      },
      {
        "matcher": "collaborationspawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "__HOOKTEST_DIR__/hooks/log.sh M-collaborationspawn_agent"
          }
        ]
      },
      {
        "matcher": "^collaboration\\.spawn_agent$",
        "hooks": [
          {
            "type": "command",
            "command": "__HOOKTEST_DIR__/hooks/log.sh M-collaboration.spawn_agent"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "__HOOKTEST_DIR__/hooks/log.sh PostToolUse"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOOKTEST_DIR__/hooks/subagent_start.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOOKTEST_DIR__/hooks/subagent_stop.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOOKTEST_DIR__/hooks/log.sh Stop"
          }
        ]
      }
    ]
  }
}