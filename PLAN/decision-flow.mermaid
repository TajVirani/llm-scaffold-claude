    class setup external
    class gTrivial,gModel,gProfile,gFromDef,gTerm0,gDup,gPlace,gADR,gAny,gDefer,gTerm1,gScope,gOpen,gLight,gTerm2,gConflict,gReady,gHarness,gSpecifiable,gSeams,gCore,gTool,gMini,gSuites,gGreen,gE2E,gRoute,gThird,gRounds,gApprove,dwAssess,gDwBlocker,gDwDiscovery,gDwAsk,gTaskBudget,gWaveBudget gate
    class spec index
    class convert,lgEnter,lgWriteBack,lgFrontier,lgAsk,lgSlices,lgLog,lgEmit,lgPlanned,lgMerge,lgReopen stage
